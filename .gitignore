## macOS
.DS_Store

## python bytecode
__pycache__/

## code env
.venv/

## escape hatch: append `.gitignored` to any filename to exclude it from version control
*.gitignored

## output directories
md_files/
pdfs/

## do not track personal instances of config files
configs/ai/ai_provider.toml
configs/ai/user_profile.txt
configs/search/*.toml
configs/sheets/sheets_config.toml
## Google Sheets OAuth credentials and tokens
configs/sheets/client_secret.json
configs/sheets/token.json
## create copies of the `*.example` files under configs/ to get started
!configs/search/example.toml
